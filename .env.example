# 数据库配置示例
DATABASE_URL=mysql+aiomysql://root:your_password@127.0.0.1:3306/freshplate_db?charset=utf8mb4

# 可选：设置后 SQLite 数据库与用户上传图片会写入此持久目录
PERSISTENT_DATA_DIR=

# AI 服务密钥配置（部署平台中作为 Secret 设置，不要提交真实密钥）
DEEPSEEK_API_KEY=your-chat-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

VISION_API_KEY=your-vision-api-key
VISION_BASE_URL=https://api.deepseek.com
VISION_MODEL=deepseek-flash

# 生产环境必须设置为随机长字符串
SECRET_KEY=replace-with-a-random-secret

# 首次启动时可选创建管理员；创建后可删除这两个环境变量
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
